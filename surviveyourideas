		task.wait(0.2)
		local _, _, hrp = getCharacterAndRoot()
		if hrp and not currentOriginPos then
			currentOriginPos = hrp.Position
		end
		syncHotbarSelection(Runtime.autoFarmRunId, true)
	end
end))

