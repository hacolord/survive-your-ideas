-- Khi mới bật code: bắt buộc nhận định server hiện tại là server lobby,
-- đóng băng Auto Farm (kể cả khi bật Auto Farm), tự click toạ độ 328;265 mỗi 5s tối đa 3 lần.
-- Mỗi khi ID server chuyển đổi (kể cả quay lại server có ID giống server lobby ban đầu):
-- ghi nhận sự chuyển đổi để đảo trạng thái giữa server lobby và ván game thực sự.
local function getCurrentServerSignature()
	local placeIdStr = tostring(game.PlaceId or 0)
	local jobIdStr = tostring(game.JobId or "")
	return placeIdStr .. ":" .. jobIdStr
end

local ServerState = {
	lastSignature = getCurrentServerSignature(),
	isLobbyFrozen = true,
	lobbyClickSessionId = 0,
	lobbyClicksDone = 0
}

local function clickAtLobbyCoordsOnce()
	if not VirtualInputManager then
		return
	end
	local lx = tonumber(Config.LOBBY_CLICK_X) or 328
	local ly = tonumber(Config.LOBBY_CLICK_Y) or 265
	local hold = tonumber(Config.CLICK_HOLD) or 0.05
	pcall(function()
		VirtualInputManager:SendMouseButtonEvent(lx, ly, 0, true, game, 1)
		task.wait(hold)
		VirtualInputManager:SendMouseButtonEvent(lx, ly, 0, false, game, 1)
	end)
end

local function startLobbyClickSequence()
	ServerState.lobbyClickSessionId = (ServerState.lobbyClickSessionId or 0) + 1
	local mySession = ServerState.lobbyClickSessionId
	ServerState.lobbyClicksDone = 0

	task.spawn(function()
		local maxClicks = tonumber(Config.LOBBY_MAX_CLICKS) or 3
		local interval = tonumber(Config.LOBBY_CLICK_INTERVAL) or 5.0

		while ServerState.isLobbyFrozen and ServerState.lobbyClickSessionId == mySession and ServerState.lobbyClicksDone < maxClicks do
			clickAtLobbyCoordsOnce()
			ServerState.lobbyClicksDone += 1

			if ServerState.lobbyClicksDone >= maxClicks or not ServerState.isLobbyFrozen or ServerState.lobbyClickSessionId ~= mySession then
				break
			end

			local elapsed = 0
			while elapsed < interval do
				if not ServerState.isLobbyFrozen or ServerState.lobbyClickSessionId ~= mySession then
					return
				end
				local dt = task.wait(math.min(0.1, interval - elapsed))
				elapsed += (dt or 0.1)
			end
		end
	end)
end

local function enterLobbyFrozenState(reasonText)
	ServerState.isLobbyFrozen = true
	startLobbyClickSequence()
	if reasonText then
		notifyUser("Server Lobby", reasonText, 4)
	end
end

local function exitLobbyFrozenState(reasonText)
	ServerState.isLobbyFrozen = false
	ServerState.lobbyClickSessionId = (ServerState.lobbyClickSessionId or 0) + 1
	ServerState.lobbyClicksDone = 0
	if reasonText then
		notifyUser("Vào ván game", reasonText, 4)
	end
end

local function handleServerIdTransition(newSig)
	ServerState.lastSignature = newSig
	if ServerState.isLobbyFrozen then
		-- Đang ở lobby -> chuyển sang server ván game thực sự: huỷ đóng băng Auto Farm
		exitLobbyFrozenState("Đã phát hiện chuyển đổi ID server sang ván game. Đã huỷ đóng băng Auto Farm.")
	else
		-- Đang ở ván game -> chuyển về lại lobby (kể cả cùng ID server cũ): nhận định là lobby, đóng băng Auto Farm và click lại 3 lần
		enterLobbyFrozenState("Đã phát hiện chuyển đổi ID server về lobby. Đóng băng Auto Farm và tự click 328;265 mỗi 5s (tối đa 3 lần).")
	end
end

-- Khởi động luồng theo dõi chuyển đổi ID server ngay khi script chạy
do
	Runtime.lobbyWatcherRunId = (Runtime.lobbyWatcherRunId or 0) + 1
	local myWatcherId = Runtime.lobbyWatcherRunId
	ServerState.lastSignature = getCurrentServerSignature()
	ServerState.isLobbyFrozen = true
	startLobbyClickSequence()

	task.spawn(function()
		while Runtime.lobbyWatcherRunId == myWatcherId do
			local poll = tonumber(Config.SERVER_POLL_INTERVAL) or 0.5
			task.wait(poll)
			if Runtime.lobbyWatcherRunId ~= myWatcherId then
				return
			end
			local currentSig = getCurrentServerSignature()
			if currentSig ~= ServerState.lastSignature then
				handleServerIdTransition(currentSig)
			end
		end
	end)
end

