SettingTab:CreateButton({
	Name = "Load",
	Callback = function()
		showClassicConfirm(
			"Xác nhận tải cấu hình",
			"Bạn có chắc muốn TẢI cấu hình đã lưu không?",
			function()
				performLoadConfig(false)
			end
		)
	end
})

-- 2.4 Auto Load — Toggle
Elements.autoLoad = SettingTab:CreateToggle({
	Name = "Auto Load",
	CurrentValue = Config.autoLoad,
	Flag = nil,
	Callback = function(Value)
		if isLoading then
			return
		end
		Config.autoLoad = Value == true
	end
})

-- ============================================================================
-- [ KHU VỰC 11: TỰ ĐỘNG LOAD KHI KHỞI ĐỘNG NẾU AUTOLOAD BẬT ]
-- ============================================================================
do
	local okReadInit, rawInit = readSavedConfigJson()
	if okReadInit and type(rawInit) == "string" then
		local okDecInit, decodedInit = pcall(function()
			return HttpService:JSONDecode(rawInit)
		end)
		if okDecInit and type(decodedInit) == "table" and decodedInit.autoLoad == true then
			mergeConfigFromDecoded(decodedInit)
			applyConfigToUIAndLogic(true)
		end
	end
end
