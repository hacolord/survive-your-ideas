local Window = Rayfield:CreateWindow({
	Name = "Auto Farm Hub",
	Icon = 0,
	LoadingTitle = "Auto Farm Hub",
	LoadingSubtitle = "Rayfield UI",
	Theme = "Default",
	DisableRayfieldPrompts = false,
	DisableBuildWarnings = false,
	ConfigurationSaving = {
		Enabled = false,
		FolderName = nil,
		FileName = "Config"
	},
	Discord = {
		Enabled = false,
		Invite = "",
		RememberJoins = false
	},
	KeySystem = false
})

local AutoFarmTab = Window:CreateTab("Auto Farm", nil)
local SettingTab = Window:CreateTab("Setting", nil)

-- ----------------------------------------------------------------------------
-- TAB 1: "AUTO FARM" (ĐÚNG 5 PHẦN TỬ THEO THỨ TỰ)
-- ----------------------------------------------------------------------------

-- 1.1 Auto Farm — Toggle (mặc định tắt)
Elements.autoFarm = AutoFarmTab:CreateToggle({
	Name = "Auto Farm",
	CurrentValue = Config.autoFarm,
	Flag = nil,
	Callback = function(Value)
		if isLoading then
			return
		end
		if Value then
			startAutoFarm()
		else
			stopAutoFarm()
		end
	end
})

-- 1.2 Vật phẩm — Dropdown (chọn đúng 1 trong 5, mặc định "1")
Elements.item = AutoFarmTab:CreateDropdown({
	Name = "Vật phẩm",
	Options = { "1", "2", "3", "4", "5" },
	CurrentOption = { Config.item },
	MultipleOptions = false,
	Flag = nil,
	Callback = function(Options)
		if isLoading then
			return
		end
		local chosen = (type(Options) == "table" and Options[1]) or tostring(Options or "1")
		if not Config.ITEM_KEY_MAP[tostring(chosen)] then
			chosen = "1"
		end
		Config.item = tostring(chosen)
		if Config.autoFarm and not ServerState.isLobbyFrozen then
			syncHotbarSelection(Runtime.autoFarmRunId, true)
		end
	end
})

-- 1.3 Phát hiện click — Toggle (mặc định tắt)
Elements.detectClick = AutoFarmTab:CreateToggle({
	Name = "Phát hiện click",
	CurrentValue = Config.detectClick,
	Flag = nil,
	Callback = function(Value)
		if isLoading then
			return
		end
		Config.detectClick = Value == true
		if Config.detectClick then
			createDetectClickMiniGui()
		else
			destroyDetectClickMiniGui()
		end
	end
})

-- 1.4 Click toạ độ — Input (mặc định "380;172")
Elements.clickCoordsRaw = AutoFarmTab:CreateInput({
	Name = "Click toạ độ",
	CurrentValue = tostring(Config.clickCoordsRaw or "380;172"),
	PlaceholderText = "Ví dụ: 320;172",
	RemoveTextAfterFocusLost = false,
	Flag = nil,
	Callback = function(Text)
		if isLoading then
			return
		end
		local px, py = parseCoordsString(tostring(Text or ""))
		if px and py then
			Config.clickCoordsRaw = tostring(Text)
			Config.clickX = px
			Config.clickY = py
		else
			notifyUser("Click toạ độ", "Định dạng không hợp lệ (dùng dạng X;Y, ví dụ 320;172). Giữ giá trị cũ: " .. tostring(Config.clickCoordsRaw), 4)
			if Elements.clickCoordsRaw then
				pcall(function()
					Elements.clickCoordsRaw:Set(tostring(Config.clickCoordsRaw))
				end)
			end
		end
	end
})

-- 1.5 Ghi textbox — Input (mặc định rỗng)
Elements.textboxText = AutoFarmTab:CreateInput({
	Name = "Ghi textbox",
	CurrentValue = tostring(Config.textboxText or ""),
	PlaceholderText = "Để trống nếu không ghi chữ",
	RemoveTextAfterFocusLost = false,
	Flag = nil,
	Callback = function(Text)
		if isLoading then
			return
		end
		Config.textboxText = tostring(Text or "")
	end
})

