-- [ KHU VỰC 6: ĐIỀU KHIỂN VÒNG LẶP AUTO FARM THEO RUNID ]
-- ============================================================================
local currentOriginPos = nil

local function stopAutoFarm()
	Config.autoFarm = false
	Runtime.autoFarmRunId = (Runtime.autoFarmRunId or 0) + 1
	local originToRestore = currentOriginPos
	currentOriginPos = nil
	lastEquippedItem = nil
	isBusy = false
	if originToRestore then
		returnToOrigin(originToRestore)
	end
end

local function startAutoFarm()
	Runtime.autoFarmRunId = (Runtime.autoFarmRunId or 0) + 1
	local myRunId = Runtime.autoFarmRunId
	Config.autoFarm = true
	lastEquippedItem = nil
	lastItemCheckClock = 0

	local _, _, hrp = ensureCharacterReady()
	if not hrp then
		Config.autoFarm = false
		notifyUser("Auto Farm", "Không tìm thấy HumanoidRootPart.", 3)
		return
	end

	currentOriginPos = hrp.Position

	-- Nếu đang ở server lobby thì đóng băng Auto Farm (không chạy vòng lặp farm khi đang ở lobby)
	if ServerState.isLobbyFrozen then
		notifyUser("Auto Farm", "Đang ở server lobby: Auto Farm bị đóng băng cho tới khi sang server ván game.", 4)
		return
	end

	-- Bấm phím chọn đồ 1 lần ngay khi bật Auto Farm
	syncHotbarSelection(myRunId, true)

	-- Dịch chuyển lên độ cao ngẫu nhiên lần đầu ngay lúc bật
	teleportVerticalStep(currentOriginPos, myRunId)

	-- Luồng 1: Dịch chuyển độ cao ngẫu nhiên mỗi TELEPORT_INTERVAL (0.75s) + kiểm tra định kỳ cầm đồ
	task.spawn(function()
		while Config.autoFarm and Runtime.autoFarmRunId == myRunId do
			local interval = tonumber(Config.TELEPORT_INTERVAL) or 0.75
			local elapsed = 0
			while elapsed < interval do
				if not Config.autoFarm or Runtime.autoFarmRunId ~= myRunId then
					return
				end
				local dt = task.wait(math.min(0.05, interval - elapsed))
				elapsed += (dt or 0.05)
			end

			if not Config.autoFarm or Runtime.autoFarmRunId ~= myRunId then
				return
			end

			if not ServerState.isLobbyFrozen then
				-- Đảm bảo có originPos nếu nhân vật vừa respawn
				local _, _, curHrp = getCharacterAndRoot()
				if curHrp and not currentOriginPos then
					currentOriginPos = curHrp.Position
				end

				syncHotbarSelection(myRunId, false)
				teleportVerticalStep(currentOriginPos, myRunId)
			end
		end
	end)

	-- Luồng 2: Click toạ độ liên tục + phát hiện/ghi textbox khi Auto Farm bật (và không bị đóng băng ở lobby)
	task.spawn(function()
		while Config.autoFarm and Runtime.autoFarmRunId == myRunId do
			if not ServerState.isLobbyFrozen then
				clickTargetAndTypeOnce(myRunId)
			end
			if not Config.autoFarm or Runtime.autoFarmRunId ~= myRunId then
				return
			end
			task.wait(Config.CLICK_LOOP_DELAY or 0.08)
		end
	end)
end

-- Theo dõi respawn để khi bật Auto Farm vẫn giữ originPos hoặc tái đồng bộ khi cần
trackConnection(LocalPlayer.CharacterAdded:Connect(function()
	if Config.autoFarm and not ServerState.isLobbyFrozen then
