local function colorToTable(c3)
	if typeof(c3) == "Color3" then
		return {
			r = math.floor(c3.R * 255 + 0.5),
			g = math.floor(c3.G * 255 + 0.5),
			b = math.floor(c3.B * 255 + 0.5)
		}
	elseif type(c3) == "table" then
		return {
			r = tonumber(c3.r) or 255,
			g = tonumber(c3.g) or 40,
			b = tonumber(c3.b) or 40
		}
	end
	return { r = 255, g = 40, b = 40 }
end

local function tableToColor(tbl)
	if typeof(tbl) == "Color3" then
		return tbl
	end
	if type(tbl) == "table" then
		local r = tonumber(tbl.r) or 255
		local g = tonumber(tbl.g) or 40
		local b = tonumber(tbl.b) or 40
		if r <= 1 and g <= 1 and b <= 1 and (r > 0 or g > 0 or b > 0) then
			return Color3.new(r, g, b)
		end
		return Color3.fromRGB(math.clamp(r, 0, 255), math.clamp(g, 0, 255), math.clamp(b, 0, 255))
	end
	return Color3.fromRGB(255, 40, 40)
end

local function vec2ToTable(v2)
	if typeof(v2) == "Vector2" then
		return { x = v2.X, y = v2.Y }
	elseif type(v2) == "table" then
		return { x = tonumber(v2.x) or 0, y = tonumber(v2.y) or 0 }
	end
	return { x = 0, y = 0 }
end

local function udim2ToTable(u2)
	if typeof(u2) == "UDim2" then
		return {
			xScale = u2.X.Scale,
			xOffset = u2.X.Offset,
			yScale = u2.Y.Scale,
			yOffset = u2.Y.Offset
		}
	elseif type(u2) == "table" then
		return {
			xScale = tonumber(u2.xScale) or 0,
			xOffset = tonumber(u2.xOffset) or 22,
			yScale = tonumber(u2.yScale) or 0,
			yOffset = tonumber(u2.yOffset) or 22
		}
	end
	return { xScale = 0, xOffset = 22, yScale = 0, yOffset = 22 }
end

