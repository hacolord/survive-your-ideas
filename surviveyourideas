local rng = Random.new()
local lastEquippedItem = nil
local lastItemCheckClock = 0

local function resolveKeyCodeFromItem(itemStr)
	local keyStr = tostring(itemStr or "1")
	local mapTable = Config.ITEM_KEY_MAP or DEFAULT_CONFIG.ITEM_KEY_MAP
	local enumName = mapTable[keyStr]
	if typeof(enumName) == "EnumItem" then
		return enumName
	end
	if type(enumName) == "string" and Enum.KeyCode[enumName] then
		return Enum.KeyCode[enumName]
	end
	local fallbackMap = {
		["1"] = Enum.KeyCode.One,
		["2"] = Enum.KeyCode.Two,
		["3"] = Enum.KeyCode.Three,
		["4"] = Enum.KeyCode.Four,
		["5"] = Enum.KeyCode.Five
	}
	return fallbackMap[keyStr] or Enum.KeyCode.One
end

-- Bấm phím số 1..5 bằng bàn phím ảo (SendKeyEvent) để cầm đồ hotbar, KHÔNG ghi chữ
local function sendHotbarKeyPress(itemStr)
	if not VirtualInputManager then
		return false
	end
	local keyCode = resolveKeyCodeFromItem(itemStr)
	local ok = pcall(function()
		VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
		task.wait(Config.CLICK_HOLD or 0.05)
		VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
	end)
	return ok
end

-- Kiểm tra xem nhân vật hiện có đang cầm Tool nào không
local function hasEquippedTool()
	local char = LocalPlayer.Character
	if not char then
		return false
	end
	return char:FindFirstChildOfClass("Tool") ~= nil
end

-- Xử lý cầm đồ: bấm 1 lần khi bật hoặc khi đổi lựa chọn, sau đó kiểm tra định kỳ ~1s nếu chưa cầm mới bấm lại
local function syncHotbarSelection(runId, forcePress)
	if not Config.autoFarm or ServerState.isLobbyFrozen or Runtime.autoFarmRunId ~= runId then
		return
	end

	local selectedItem = tostring(Config.item or "1")
	if lastEquippedItem ~= selectedItem then
		lastEquippedItem = selectedItem
		forcePress = true
	end

	local now = os.clock()
	if forcePress then
		sendHotbarKeyPress(selectedItem)
		lastItemCheckClock = now
		return
	end

	if (now - lastItemCheckClock) >= (Config.ITEM_CHECK_INTERVAL or 1.0) then
		lastItemCheckClock = now
		if not hasEquippedTool() then
			sendHotbarKeyPress(selectedItem)
		end
	end
end

-- Dịch chuyển thẳng đứng tới độ cao ngẫu nhiên [MIN_HEIGHT, MAX_HEIGHT] so với originPos.Y, giữ nguyên X và Z, rơi tự do
local function teleportVerticalStep(originPos, runId)
	if not Config.autoFarm or ServerState.isLobbyFrozen or Runtime.autoFarmRunId ~= runId then
		return false
	end
	local _, _, hrp = getCharacterAndRoot()
	if not hrp or not originPos then
		return false
	end

	local minH = tonumber(Config.MIN_HEIGHT) or 250
	local maxH = tonumber(Config.MAX_HEIGHT) or 1250
	if minH > maxH then
		minH, maxH = maxH, minH
	end

	local randomOffsetY = rng:NextNumber(minH, maxH)
	local targetY = originPos.Y + randomOffsetY

	local ok = pcall(function()
		hrp.CFrame = CFrame.new(originPos.X, targetY, originPos.Z)
		hrp.AssemblyLinearVelocity = Vector3.zero
	end)
	return ok
end

-- Dịch chuyển trở lại originPos khi tắt Auto Farm
local function returnToOrigin(originPos)
	if not originPos or not Config.RETURN_ON_STOP then
		return
	end
	local _, _, hrp = getCharacterAndRoot()
	if hrp then
		pcall(function()
			hrp.CFrame = CFrame.new(originPos.X, originPos.Y, originPos.Z)
			hrp.AssemblyLinearVelocity = Vector3.zero
		end)
	end
end

