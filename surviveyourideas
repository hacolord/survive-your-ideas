-- Ghi chú hệ toạ độ:
-- ScreenGui dùng IgnoreGuiInset = true nên toạ độ màn hình (0,0) là góc trên-trái thực tế của viewport/màn hình,
-- khớp trực tiếp với toạ độ (x, y) mà VirtualInputManager:SendMouseButtonEvent(x, y, ...) sử dụng.
-- Nếu cần quy đổi từ toạ độ có inset sang không inset thì trừ GuiService:GetGuiInset(); ở đây cả marker và VIM đều dùng toạ độ màn hình trực tiếp.
local function createDetectClickMiniGui()
	destroyDetectClickMiniGui()

	local sg = Instance.new("ScreenGui")
	sg.Name = "AutoFarmClickDetectorMiniGui"
	sg.IgnoreGuiInset = true
	sg.ResetOnSpawn = false
	sg.DisplayOrder = tonumber(Config.markerDisplayOrder) or 10000
	sg.Parent = getSafeGuiParent()
	detectGui = sg
	trackGui(sg)

	local sizePx = tonumber(Config.markerSizePx) or 22
	local circle = Instance.new("Frame")
	circle.Name = "ClickMarkerCircle"
	circle.Size = UDim2.fromOffset(sizePx, sizePx)
	circle.AnchorPoint = Vector2.new(0.5, 0.5)
	circle.BackgroundColor3 = tableToColor(Config.markerColor)
	circle.BorderSizePixel = 0
	circle.Active = false
	circle.Visible = false
	circle.Parent = sg

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = circle

	local stroke = Instance.new("UIStroke")
	stroke.Color = tableToColor(Config.strokeColor)
	stroke.Thickness = tonumber(Config.strokeThickness) or 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = circle

	local coordLabel = Instance.new("TextLabel")
	coordLabel.Name = "CoordLabel"
	coordLabel.Size = UDim2.fromOffset(120, 20)
	coordLabel.Position = UDim2.new(1, 6, 0.5, -10)
	coordLabel.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
	coordLabel.BackgroundTransparency = 0.25
	coordLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	coordLabel.TextStrokeTransparency = 0.3
	coordLabel.Font = Enum.Font.Code
	coordLabel.TextSize = 13
	coordLabel.TextXAlignment = Enum.TextXAlignment.Left
	coordLabel.Text = ""
	coordLabel.Active = false
	coordLabel.Parent = circle

	local function placeMarkerAt(pxX, pxY)
		local rx = math.floor(tonumber(pxX) or 0 + 0.5)
		local ry = math.floor(tonumber(pxY) or 0 + 0.5)
		circle.Position = UDim2.fromOffset(rx, ry)
		circle.Visible = true
		coordLabel.Text = string.format(" %d;%d", rx, ry)
		Config.lastClickX = rx
		Config.lastClickY = ry
		Config.lastClickRaw = string.format("%d;%d", rx, ry)
	end

	-- Nếu đã có toạ độ click gần nhất thì hiển thị lại
	if Config.lastClickX ~= nil and Config.lastClickY ~= nil then
		placeMarkerAt(Config.lastClickX, Config.lastClickY)
	end

	detectConn = trackConnection(UserInputService.InputBegan:Connect(function(input)
		if not Config.detectClick then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			local pos = input.Position
			if pos then
				placeMarkerAt(pos.X, pos.Y)
			end
		end
	end))
end

