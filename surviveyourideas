-- [ KHU VỰC 6: ĐIỀU KHIỂN VÒNG LẶP AUTO FARM THEO RUNID ]
-- ============================================================================
local currentOriginPos = nil

local function stopAutoFarm()
	Config.autoFarm = false
	Runtime.autoFarmRunId = (Runtime.autoFarmRunId or 0) + 1
	local originToRestore = currentOriginPos
	currentOriginPos = nil
	currentFlightY = nil
	isCeilingAnchored = false
	lastEquippedItem = nil
	isBusy = false
	resetTextboxCycle(false)
	applyStopState(originToRestore)
end

local function startAutoFarm()
	Runtime.autoFarmRunId = (Runtime.autoFarmRunId or 0) + 1
	local myRunId = Runtime.autoFarmRunId
	Config.autoFarm = true
	lastEquippedItem = nil
	lastItemCheckClock = 0
	currentFlightY = nil
	isCeilingAnchored = false
	isCharacterAnchoredForStop = false
	resetTextboxCycle(true)

	local _, _, hrp = ensureCharacterReady()
	if not hrp then
		Config.autoFarm = false
		notifyUser("Auto Farm", "Không tìm thấy HumanoidRootPart.", 3)
		return
	end

	-- Gỡ Anchor nếu trước đó tắt Auto Farm trong ván game bị khoá cơ thể hoặc đang neo ở trần
	pcall(function()
		hrp.Anchored = false
	end)

	currentOriginPos = hrp.Position
	currentFlightY = math.min(hrp.Position.Y, tonumber(Config.MAX_FLIGHT_HEIGHT) or 2500)

	-- Nếu đang ở server lobby (PlaceId 77900175935766) thì đóng băng Auto Farm
	if ServerState.isLobbyFrozen then
		notifyUser("Auto Farm", "Đang ở server lobby: Auto Farm bị đóng băng cho tới khi sang PlaceId ván game.", 4)
		return
	end

	-- Bấm phím chọn đồ 1 lần ngay khi bật Auto Farm
	syncHotbarSelection(myRunId, true)

	-- Luồng 1: Bay lên trời bằng CFrame liên tục theo vận tốc (stud/s) tới trần 2500 rồi anchor HRP + kiểm tra định kỳ cầm đồ
	task.spawn(function()
		while Config.autoFarm and Runtime.autoFarmRunId == myRunId do
			local dt = RunService.Heartbeat:Wait()
			if not Config.autoFarm or Runtime.autoFarmRunId ~= myRunId then
				return
			end

			if not ServerState.isLobbyFrozen then
				local _, _, curHrp = getCharacterAndRoot()
				if curHrp then
					if not currentOriginPos then
						currentOriginPos = curHrp.Position
					end
					if type(currentFlightY) ~= "number" then
						currentFlightY = math.min(curHrp.Position.Y, tonumber(Config.MAX_FLIGHT_HEIGHT) or 2500)
					end
				end

				syncHotbarSelection(myRunId, false)
				flyUpwardByCFrameStep(currentOriginPos, dt, myRunId)
			end
		end
	end)

	-- Luồng 2: Khi Click ảo đang bật thì click toạ độ từ tốn + phát hiện/ghi từng từ một khi Auto Farm bật (và không bị đóng băng ở lobby)
	task.spawn(function()
		while Config.autoFarm and Runtime.autoFarmRunId == myRunId do
			if not ServerState.isLobbyFrozen and isVirtualClickEnabled() then
				clickTargetAndTypeOnce(myRunId)
			end
			if not Config.autoFarm or Runtime.autoFarmRunId ~= myRunId then
				return
			end
			task.wait(Config.CLICK_LOOP_DELAY or 0.65)
		end
	end)
end

-- Theo dõi respawn để khi bật Auto Farm vẫn giữ originPos hoặc tái đồng bộ khi cần
trackConnection(LocalPlayer.CharacterAdded:Connect(function()
	if Config.autoFarm and not ServerState.isLobbyFrozen then
		lastEquippedItem = nil
		isCeilingAnchored = false
		task.wait(0.2)
		local _, _, hrp = getCharacterAndRoot()
		if hrp then
			pcall(function()
				hrp.Anchored = false
			end)
			if not currentOriginPos then
				currentOriginPos = hrp.Position
			end
			currentFlightY = math.min(hrp.Position.Y, tonumber(Config.MAX_FLIGHT_HEIGHT) or 2500)
		end
		syncHotbarSelection(Runtime.autoFarmRunId, true)
	elseif not Config.autoFarm and isCharacterAnchoredForStop then
		task.wait(0.2)
		setCharacterAnchoredState(true)
	end
end))

