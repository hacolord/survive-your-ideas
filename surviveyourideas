	return applyConfigToUIAndLogic(silentAutoLoad)
end

-- Parse chuỗi dạng "X;Y" (cho phép khoảng trắng quanh dấu ';')
local function parseCoordsString(rawStr)
	if type(rawStr) ~= "string" then
		return nil, nil
	end
	local trimmed = string.match(rawStr, "^%s*(.-)%s*$") or ""
	local sx, sy = string.match(trimmed, "^([+-]?%d*%.?%d+)%s*;%s*([+-]?%d*%.?%d+)$")
	if not sx or not sy then
		return nil, nil
	end
	local nx = tonumber(sx)
	local ny = tonumber(sy)
	if not nx or not ny then
		return nil, nil
	end
	return nx, ny
end

