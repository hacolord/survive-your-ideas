local function buildAutoExecLoaderCode()
	return 'loadstring(game:HttpGet("' .. tostring(SCRIPT_URL) .. '"))()'
end

local function applyAutoExecuteState(enabled)
	if enabled then
		if not SCRIPT_URL or SCRIPT_URL == "" or SCRIPT_URL == "ĐIỀN_LINK_RAW_CỦA_SCRIPT_NÀY_VÀO_ĐÂY" then
			Config.autoExecute = false
			if Elements.autoExecute then
				pcall(function() Elements.autoExecute:Set(false) end)
			end
			notifyUser("Auto Execute", "Vui lòng điền link raw hợp lệ vào biến SCRIPT_URL ở đầu script trước khi bật.", 5)
			return false
		end

		local loaderCode = buildAutoExecLoaderCode()
		local wroteFile = false
		if hasExecutorFn("makefolder") then
			callExecutorFn("makefolder", "autoexec")
		end
		if hasExecutorFn("writefile") then
			local okW, errW = callExecutorFn("writefile", AUTOEXEC_FILE, loaderCode)
			if okW then
				wroteFile = true
			else
				notifyUser("Auto Execute", "Không ghi được file autoexec: " .. tostring(errW), 4)
			end
		end

		if hasExecutorFn("queue_on_teleport") then
			callExecutorFn("queue_on_teleport", loaderCode)
		end

		Config.autoExecute = true
		if not wroteFile then
			notifyUser("Auto Execute", "Đã kích hoạt queue_on_teleport (hoặc kiểm tra quyền writefile).", 4)
		end
		return true
	else
		Config.autoExecute = false
		if hasExecutorFn("isfile") and hasExecutorFn("delfile") then
			local okIs, exists = callExecutorFn("isfile", AUTOEXEC_FILE)
			if okIs and exists then
				callExecutorFn("delfile", AUTOEXEC_FILE)
			end
		elseif hasExecutorFn("delfile") then
			callExecutorFn("delfile", AUTOEXEC_FILE)
		end
		return true
	end
end

local function readSavedConfigJson()
	-- Ưu tiên AutoFarmHub/config.json, dự phòng tên file phẳng AutoFarmHub_config.json
	if hasExecutorFn("isfile") and hasExecutorFn("readfile") then
		local ok1, ex1 = callExecutorFn("isfile", CONFIG_FILE)
		if ok1 and ex1 then
			return callExecutorFn("readfile", CONFIG_FILE)
		end
		local ok2, ex2 = callExecutorFn("isfile", FLAT_CONFIG_FILE)
		if ok2 and ex2 then
			return callExecutorFn("readfile", FLAT_CONFIG_FILE)
		end
		return false, "NOT_FOUND"
	elseif hasExecutorFn("readfile") then
		local ok1, res1 = callExecutorFn("readfile", CONFIG_FILE)
		if ok1 and type(res1) == "string" then
			return true, res1
		end
		local ok2, res2 = callExecutorFn("readfile", FLAT_CONFIG_FILE)
		if ok2 and type(res2) == "string" then
			return true, res2
		end
		return false, "NOT_FOUND"
	end
	return false, "Executor không hỗ trợ readfile"
end

local function writeSavedConfigJson(encodedStr)
	if not hasExecutorFn("writefile") then
		return false, "Executor không hỗ trợ writefile"
	end
	if hasExecutorFn("makefolder") then
		callExecutorFn("makefolder", CONFIG_FOLDER)
	end
	local okMain, errMain = callExecutorFn("writefile", CONFIG_FILE, encodedStr)
	if okMain then
		return true, CONFIG_FILE
	end
	local okFlat, errFlat = callExecutorFn("writefile", FLAT_CONFIG_FILE, encodedStr)
	if okFlat then
		return true, FLAT_CONFIG_FILE
	end
	return false, tostring(errMain) .. " | " .. tostring(errFlat)
end

local function performSaveConfig()
	Config.version = "1.1.0"
	Config.savedAt = os.time()

	local okEnc, encoded = pcall(function()
		return HttpService:JSONEncode(Config)
	end)
	if not okEnc or type(encoded) ~= "string" then
		notifyUser("Save", "Lỗi mã hoá JSON cấu hình.", 4)
		return
	end

	local okWrite, info = writeSavedConfigJson(encoded)
	if okWrite then
		notifyUser("Save", "Đã lưu toàn bộ cấu hình thành công (" .. tostring(info) .. ").", 4)
	else
		notifyUser("Save", "Lưu thất bại: " .. tostring(info), 5)
	end
end

local function applyConfigToUIAndLogic(silentAutoLoad)
	isLoading = true
	local okWrap, errWrap = pcall(function()
		-- Cập nhật UI elements theo Config
		if Elements.item then
			pcall(function() Elements.item:Set({ Config.item }) end)
		end
		if Elements.clickCoordsRaw then
			pcall(function() Elements.clickCoordsRaw:Set(tostring(Config.clickCoordsRaw or "380;172")) end)
		end
		if Elements.textboxText then
			pcall(function() Elements.textboxText:Set(tostring(Config.textboxText or "")) end)
		end
		if Elements.detectClick then
			pcall(function() Elements.detectClick:Set(Config.detectClick == true) end)
		end
		if Elements.autoExecute then
			pcall(function() Elements.autoExecute:Set(Config.autoExecute == true) end)
		end
		if Elements.autoLoad then
			pcall(function() Elements.autoLoad:Set(Config.autoLoad == true) end)
		end
		if Elements.autoFarm then
			pcall(function() Elements.autoFarm:Set(Config.autoFarm == true) end)
		end

		-- Áp dụng trực tiếp logic trạng thái sau khi gán UI
		if Config.detectClick then
			createDetectClickMiniGui()
		else
			destroyDetectClickMiniGui()
		end

		if Config.autoExecute then
			applyAutoExecuteState(true)
		end

		if Config.autoFarm then
			startAutoFarm()
		else
			stopAutoFarm()
		end
	end)
	isLoading = false

	if not okWrap then
		notifyUser("Load", "Lỗi áp dụng cấu hình: " .. tostring(errWrap), 4)
		return false
	end

	if silentAutoLoad then
		notifyUser("Auto Load", "Đã tự động load", 4)
	else
		notifyUser("Load", "Đã tải và áp dụng toàn bộ cấu hình.", 4)
	end
	return true
end

local function performLoadConfig(silentAutoLoad)
	local okRead, rawContent = readSavedConfigJson()
	if not okRead then
		if rawContent == "NOT_FOUND" then
			if not silentAutoLoad then
				notifyUser("Load", "chưa có cấu hình đã lưu", 4)
			end
		else
			notifyUser("Load", tostring(rawContent), 4)
		end
		return false
	end

	local okDec, decoded = pcall(function()
		return HttpService:JSONDecode(rawContent)
	end)
	if not okDec or type(decoded) ~= "table" then
		notifyUser("Load", "File cấu hình bị hỏng hoặc không phải JSON hợp lệ.", 4)
		return false
	end

	mergeConfigFromDecoded(decoded)
	return applyConfigToUIAndLogic(silentAutoLoad)
end

-- Parse chuỗi dạng "X;Y" (cho phép khoảng trắng quanh dấu ';')
local function parseCoordsString(rawStr)
	if type(rawStr) ~= "string" then
		return nil, nil
	end
	local trimmed = string.match(rawStr, "^%s*(.-)%s*$") or ""
	local sx, sy = string.match(trimmed, "^([+-]?%d*%.?%d+)%s*;%s*([+-]?%d*%.?%d+)$")
	if not sx or not sy then
		return nil, nil
	end
	local nx = tonumber(sx)
	local ny = tonumber(sy)
	if not nx or not ny then
		return nil, nil
	end
	return nx, ny
end

