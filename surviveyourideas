		task.wait(hold)
		VirtualInputManager:SendMouseButtonEvent(mx, my, 0, false, game, 1)
	end)
end

local function startMatchClickSequence()
	if not isGamePlaceId(getCurrentPlaceIdNumber()) then
		return
	end
	ServerState.matchClickSessionId = (ServerState.matchClickSessionId or 0) + 1
	local myMatchSession = ServerState.matchClickSessionId
	ServerState.matchClicksDone = 0

	task.spawn(function()
		local initialDelay = tonumber(Config.MATCH_CLICK_INITIAL_DELAY) or 7.5
		local maxClicks = tonumber(Config.MATCH_CLICK_MAX_COUNT) or 3
		local interval = tonumber(Config.MATCH_CLICK_INTERVAL) or 5.0

		local elapsedInit = 0
		while elapsedInit < initialDelay do
			if not isGamePlaceId(getCurrentPlaceIdNumber()) or ServerState.matchClickSessionId ~= myMatchSession then
				return
			end
			local dt = task.wait(math.min(0.1, initialDelay - elapsedInit))
			elapsedInit += (dt or 0.1)
		end

		while isGamePlaceId(getCurrentPlaceIdNumber()) and ServerState.matchClickSessionId == myMatchSession and ServerState.matchClicksDone < maxClicks do
			if isVirtualClickEnabled() then
				clickAtMatchCoordsOnce()
			end
			ServerState.matchClicksDone += 1

			if ServerState.matchClicksDone >= maxClicks or not isGamePlaceId(getCurrentPlaceIdNumber()) or ServerState.matchClickSessionId ~= myMatchSession then
				break
			end

			local elapsed = 0
			while elapsed < interval do
				if not isGamePlaceId(getCurrentPlaceIdNumber()) or ServerState.matchClickSessionId ~= myMatchSession then
					return
				end
				local dt = task.wait(math.min(0.1, interval - elapsed))
				elapsed += (dt or 0.1)
			end
		end
	end)
end

local function startLobbyClickSequence()
	if not isLobbyPlaceId(getCurrentPlaceIdNumber()) then
		return
	end
	ServerState.lobbyClickSessionId = (ServerState.lobbyClickSessionId or 0) + 1
	local mySession = ServerState.lobbyClickSessionId
	ServerState.lobbyClicksDone = 0

	task.spawn(function()
		local maxClicks = tonumber(Config.LOBBY_MAX_CLICKS) or 3
		local interval = tonumber(Config.LOBBY_CLICK_INTERVAL) or 5.0

		while ServerState.isLobbyFrozen and isLobbyPlaceId(getCurrentPlaceIdNumber()) and ServerState.lobbyClickSessionId == mySession and ServerState.lobbyClicksDone < maxClicks do
			if isVirtualClickEnabled() then
				clickAtLobbyCoordsOnce()
			end
			ServerState.lobbyClicksDone += 1

			if ServerState.lobbyClicksDone >= maxClicks or not ServerState.isLobbyFrozen or not isLobbyPlaceId(getCurrentPlaceIdNumber()) or ServerState.lobbyClickSessionId ~= mySession then
				break
			end

			local elapsed = 0
			while elapsed < interval do
				if not ServerState.isLobbyFrozen or not isLobbyPlaceId(getCurrentPlaceIdNumber()) or ServerState.lobbyClickSessionId ~= mySession then
					return
				end
				local dt = task.wait(math.min(0.1, interval - elapsed))
				elapsed += (dt or 0.1)
			end
		end
	end)
end

local function enterLobbyFrozenState(reasonText)
	ServerState.isLobbyFrozen = true
	ServerState.matchClickSessionId = (ServerState.matchClickSessionId or 0) + 1
	ServerState.matchClicksDone = 0
	savePersistedServerState(ServerState.lastPlaceId, true)
	startLobbyClickSequence()
	if reasonText then
		notifyUser("Server Lobby", reasonText, 4)
	end
end

local function exitLobbyFrozenState(reasonText)
	ServerState.isLobbyFrozen = false
	savePersistedServerState(ServerState.lastPlaceId, false)
	ServerState.lobbyClickSessionId = (ServerState.lobbyClickSessionId or 0) + 1
	ServerState.lobbyClicksDone = 0
	startMatchClickSequence()
	if reasonText then
		notifyUser("Vào ván game", reasonText, 4)
	end
end

local function applyPlaceIdState(placeIdNum)
