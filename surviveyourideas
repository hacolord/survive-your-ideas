-- Đặt bộ nhận diện PlaceId (lobby = 77900175935766, ván game = 109001332046330) NGAY ĐẰNG TRƯỚC loadstring(game:HttpGet(SCRIPT_URL))()
-- để khi auto execute hoặc teleport chạy lại, trạng thái lobby/ván game được ghi nhận trước khi mã chính chạy.
local function buildAutoExecLoaderCode()
	local urlStr = tostring(SCRIPT_URL)
	local preLoadGuard = [=[
pcall(function()
	if not game:IsLoaded() then game.Loaded:Wait() end
	local HttpService = game:GetService("HttpService")
	local VirtualInputManager = pcall(function() return game:GetService("VirtualInputManager") end) and game:GetService("VirtualInputManager")
	local env = getgenv()
	env.__AutoFarmHub_Runtime_State__ = env.__AutoFarmHub_Runtime_State__ or {}
	local rt = env.__AutoFarmHub_Runtime_State__
	local curPlaceId = tonumber(game.PlaceId) or 0
	local lobbyPlaceId = 77900175935766
	local gamePlaceId = 109001332046330
	local nextFrozen = false
	if curPlaceId == lobbyPlaceId then
		nextFrozen = true
	elseif curPlaceId == gamePlaceId then
		nextFrozen = false
	end
	rt.persistedServerState = {
		lastPlaceId = curPlaceId,
		isLobbyFrozen = nextFrozen,
		initialized = true
	}
	local allowVirtualClick = false
	if type(readfile) == "function" then
		local okCfg, rawCfg = pcall(function()
			if type(isfile) == "function" and isfile("AutoFarmHub/config.json") then
				return readfile("AutoFarmHub/config.json")
			elseif type(isfile) == "function" and isfile("AutoFarmHub_config.json") then
				return readfile("AutoFarmHub_config.json")
			end
			return nil
		end)
		if okCfg and type(rawCfg) == "string" then
			local okDecCfg, decCfg = pcall(function()
				return HttpService:JSONDecode(rawCfg)
			end)
			if okDecCfg and type(decCfg) == "table" and decCfg.virtualClick == true then
				allowVirtualClick = true
			end
		end
	end
	if type(writefile) == "function" then
		if type(makefolder) == "function" then pcall(makefolder, "AutoFarmHub") end
		local okEnc, enc = pcall(function()
			return HttpService:JSONEncode({
				lastPlaceId = curPlaceId,
				isLobbyFrozen = nextFrozen,
				updatedAt = os.time()
			})
		end)
		if okEnc and type(enc) == "string" then
			pcall(writefile, "AutoFarmHub/server_transition_state.json", enc)
		end
	end
	if curPlaceId == gamePlaceId and allowVirtualClick and VirtualInputManager then
		rt.preMatchClickToken = (tonumber(rt.preMatchClickToken) or 0) + 1
		local myToken = rt.preMatchClickToken
		task.spawn(function()
			task.wait(7.5)
			for i = 1, 3 do
				if tonumber(game.PlaceId) ~= gamePlaceId or rt.preMatchClickToken ~= myToken then
					return
				end
				pcall(function()
					VirtualInputManager:SendMouseButtonEvent(607, 66, 0, true, game, 1)
					task.wait(0.06)
					VirtualInputManager:SendMouseButtonEvent(607, 66, 0, false, game, 1)
				end)
				if i < 3 then
					task.wait(5.0)
				end
			end
		end)
	end
end)
]=]
	return preLoadGuard .. 'loadstring(game:HttpGet("' .. urlStr .. '"))()'
end

local function applyAutoExecuteState(enabled)
	if enabled then
		if not SCRIPT_URL or SCRIPT_URL == "" or SCRIPT_URL == "ĐIỀN_LINK_RAW_CỦA_SCRIPT_NÀY_VÀO_ĐÂY" then
			Config.autoExecute = false
			if Elements.autoExecute then
				pcall(function() Elements.autoExecute:Set(false) end)
			end
			notifyUser("Auto Execute", "Vui lòng điền link raw hợp lệ vào biến SCRIPT_URL ở đầu script trước khi bật.", 5)
			return false
		end

		local loaderCode = buildAutoExecLoaderCode()
		local wroteFile = false
		if hasExecutorFn("makefolder") then
			callExecutorFn("makefolder", "autoexec")
		end
		if hasExecutorFn("writefile") then
			local okW, errW = callExecutorFn("writefile", AUTOEXEC_FILE, loaderCode)
			if okW then
				wroteFile = true
			else
				notifyUser("Auto Execute", "Không ghi được file autoexec: " .. tostring(errW), 4)
			end
		end

		if hasExecutorFn("queue_on_teleport") then
			callExecutorFn("queue_on_teleport", loaderCode)
		end

		Config.autoExecute = true
		if not wroteFile then
			notifyUser("Auto Execute", "Đã kích hoạt queue_on_teleport (hoặc kiểm tra quyền writefile).", 4)
		end
		return true
	else
		Config.autoExecute = false
		if hasExecutorFn("isfile") and hasExecutorFn("delfile") then
			local okIs, exists = callExecutorFn("isfile", AUTOEXEC_FILE)
			if okIs and exists then
				callExecutorFn("delfile", AUTOEXEC_FILE)
			end
		elseif hasExecutorFn("delfile") then
			callExecutorFn("delfile", AUTOEXEC_FILE)
		end
		return true
	end
end

local function readSavedConfigJson()
	-- Ưu tiên AutoFarmHub/config.json, dự phòng tên file phẳng AutoFarmHub_config.json
	if hasExecutorFn("isfile") and hasExecutorFn("readfile") then
		local ok1, ex1 = callExecutorFn("isfile", CONFIG_FILE)
		if ok1 and ex1 then
			return callExecutorFn("readfile", CONFIG_FILE)
		end
		local ok2, ex2 = callExecutorFn("isfile", FLAT_CONFIG_FILE)
		if ok2 and ex2 then
			return callExecutorFn("readfile", FLAT_CONFIG_FILE)
		end
		return false, "NOT_FOUND"
	elseif hasExecutorFn("readfile") then
		local ok1, res1 = callExecutorFn("readfile", CONFIG_FILE)
		if ok1 and type(res1) == "string" then
			return true, res1
		end
		local ok2, res2 = callExecutorFn("readfile", FLAT_CONFIG_FILE)
		if ok2 and type(res2) == "string" then
			return true, res2
		end
		return false, "NOT_FOUND"
	end
	return false, "Executor không hỗ trợ readfile"
end

local function writeSavedConfigJson(encodedStr)
	if not hasExecutorFn("writefile") then
		return false, "Executor không hỗ trợ writefile"
	end
	if hasExecutorFn("makefolder") then
		callExecutorFn("makefolder", CONFIG_FOLDER)
	end
	local okMain, errMain = callExecutorFn("writefile", CONFIG_FILE, encodedStr)
	if okMain then
		return true, CONFIG_FILE
	end
	local okFlat, errFlat = callExecutorFn("writefile", FLAT_CONFIG_FILE, encodedStr)
	if okFlat then
		return true, FLAT_CONFIG_FILE
	end
	return false, tostring(errMain) .. " | " .. tostring(errFlat)
end

