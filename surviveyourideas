-- Chuẩn hoá và nạp dữ liệu từ bảng đã decode vào Config (giữ mặc định nếu thiếu, bỏ qua key lạ)
local function mergeConfigFromDecoded(decoded)
	if type(decoded) ~= "table" then
		return
	end

	for key, defaultVal in pairs(DEFAULT_CONFIG) do
		local rawVal = decoded[key]
		if rawVal ~= nil then
			if type(defaultVal) == "boolean" then
				if type(rawVal) == "boolean" then
					Config[key] = rawVal
				end
			elseif type(defaultVal) == "number" then
				local num = tonumber(rawVal)
				if num then
					Config[key] = num
				end
			elseif type(defaultVal) == "string" then
				if type(rawVal) == "string" or type(rawVal) == "number" then
					Config[key] = tostring(rawVal)
				end
			elseif type(defaultVal) == "table" then
				if key == "markerColor" or key == "strokeColor" then
					Config[key] = colorToTable(rawVal)
				elseif key == "markerSize" then
					Config[key] = udim2ToTable(rawVal)
				elseif key == "markerLabelOffset" then
					Config[key] = vec2ToTable(rawVal)
				elseif key == "ITEM_KEY_MAP" and type(rawVal) == "table" then
					local mapCopy = deepCopy(defaultVal)
					for kMap, vMap in pairs(rawVal) do
						local sKey = tostring(kMap)
						if mapCopy[sKey] ~= nil and (type(vMap) == "string" or typeof(vMap) == "EnumItem") then
							mapCopy[sKey] = typeof(vMap) == "EnumItem" and vMap.Name or tostring(vMap)
						end
					end
					Config[key] = mapCopy
				end
			end
		end
	end

	-- Xử lý riêng lastClickX / lastClickY nếu có trong file
	if decoded.lastClickX ~= nil then
		Config.lastClickX = tonumber(decoded.lastClickX)
	end
	if decoded.lastClickY ~= nil then
		Config.lastClickY = tonumber(decoded.lastClickY)
	end
	if decoded.version ~= nil then
		Config.version = tostring(decoded.version)
	end
	if decoded.savedAt ~= nil then
		Config.savedAt = tonumber(decoded.savedAt) or Config.savedAt
	end
end

