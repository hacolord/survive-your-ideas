-- ============================================================================
-- [ KHU VỰC 11: TỰ ĐỘNG LOAD KHI KHỞI ĐỘNG NẾU AUTOLOAD BẬT ]
-- ============================================================================
do
	local okReadInit, rawInit = readSavedConfigJson()
	if okReadInit and type(rawInit) == "string" then
		local okDecInit, decodedInit = pcall(function()
			return HttpService:JSONDecode(rawInit)
		end)
		if okDecInit and type(decodedInit) == "table" and decodedInit.autoLoad == true then
			mergeConfigFromDecoded(decodedInit)
			applyConfigToUIAndLogic(true)
		end
	end
end
