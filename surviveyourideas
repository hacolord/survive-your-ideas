local isBusy = false

-- Lấy TextBox đang mở/được chọn (theo code tham chiếu)
local function getActiveTextBox()
	local focused = pcall(function() return UserInputService:GetFocusedTextBox() end) and UserInputService:GetFocusedTextBox()
	if focused and focused:IsA("TextBox") then
		return focused
	end
	if GuiService.SelectedObject and GuiService.SelectedObject:IsA("TextBox") then
		return GuiService.SelectedObject
	end
	return nil
end

local function isKeyboardOrBoxOpen()
	if getActiveTextBox() then
		return true
	end
	local kb = pcall(function() return UserInputService.OnScreenKeyboardVisible end) and UserInputService.OnScreenKeyboardVisible
	return kb == true
end

local function fillActiveBox(text)
	local box = getActiveTextBox()
	if box then
		pcall(function()
			box.Text = text
		end)
		task.wait(Config.POST_SET_DELAY or 0.05)
		-- Ghi đè thêm 1 lần nếu game có script reset lại lúc mới focus
		pcall(function()
			if box.Text ~= text then
				box.Text = text
			end
			box:ReleaseFocus(true)
		end)
		return true
	end

	-- Dự phòng nếu không bắt được instance TextBox nhưng bàn phím ảo đã mở
	if VirtualInputManager then
		for i = 1, #text do
			local ch = string.sub(text, i, i)
			pcall(function()
				VirtualInputManager:SendTextInputCharacterEvent(ch, game)
			end)
			task.wait(Config.CHAR_DELAY or 0.02)
		end
		return true
	end

	return false
end

-- Một lượt click toạ độ (và nếu chuỗi ghi textbox không rỗng thì chờ phát hiện tối đa 2.0s rồi điền)
local function clickTargetAndTypeOnce(runId)
	if isBusy then
		return
	end
	if not Config.autoFarm or ServerState.isLobbyFrozen or Runtime.autoFarmRunId ~= runId then
		return
	end
	isBusy = true

	local targetX = tonumber(Config.clickX) or 380
	local targetY = tonumber(Config.clickY) or 172
	local textToType = tostring(Config.textboxText or "")
	local holdTime = Config.CLICK_HOLD or 0.05

	-- 1. Click vào toạ độ đã nhập
	if VirtualInputManager then
		pcall(function()
			VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, true, game, 1)
			task.wait(holdTime)
			VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, false, game, 1)
		end)
	end

	-- 2. Nếu ô Ghi textbox không rỗng: chờ tối đa DETECT_TIMEOUT (2.0s) xem TextBox / bàn phím ảo bật lên không
	if textToType ~= "" then
		local detected = false
		local timeout = Config.DETECT_TIMEOUT or 2.0
		local pollStep = Config.POLL_STEP or 0.05
		local t0 = os.clock()
		while (os.clock() - t0) < timeout do
			if not Config.autoFarm or ServerState.isLobbyFrozen or Runtime.autoFarmRunId ~= runId then
				break
			end
			if isKeyboardOrBoxOpen() then
				detected = true
				break
			end
			task.wait(pollStep)
		end

		-- 3. Nếu phát hiện bật lên thì chờ PRE_FILL_DELAY (0.1s) rồi tự điền chuỗi
		if detected and Config.autoFarm and not ServerState.isLobbyFrozen and Runtime.autoFarmRunId == runId then
			task.wait(Config.PRE_FILL_DELAY or 0.1)
			fillActiveBox(textToType)
		end
	end

	isBusy = false
end

