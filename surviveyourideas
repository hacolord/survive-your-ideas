local function sendHotbarKeyPress(itemStr)
	if not VirtualInputManager then
		return false
	end
	local keyCode = resolveKeyCodeFromItem(itemStr)
	local ok = pcall(function()
		VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
		task.wait(Config.CLICK_HOLD or 0.06)
		VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
	end)
	return ok
end

-- Kiểm tra xem nhân vật hiện có đang cầm Tool nào không
local function hasEquippedTool()
	local char = LocalPlayer.Character
	if not char then
		return false
	end
	return char:FindFirstChildOfClass("Tool") ~= nil
end

-- Xử lý cầm đồ: bấm 1 lần khi bật hoặc khi đổi lựa chọn, sau đó kiểm tra định kỳ ~1s nếu chưa cầm mới bấm lại
local function syncHotbarSelection(runId, forcePress)
	if not Config.autoFarm or ServerState.isLobbyFrozen or Runtime.autoFarmRunId ~= runId then
		return
	end

	local selectedItem = tostring(Config.item or "1")
	if lastEquippedItem ~= selectedItem then
		lastEquippedItem = selectedItem
		forcePress = true
	end

	local now = os.clock()
	if forcePress then
		sendHotbarKeyPress(selectedItem)
		lastItemCheckClock = now
		return
	end

	if (now - lastItemCheckClock) >= (Config.ITEM_CHECK_INTERVAL or 1.0) then
		lastItemCheckClock = now
		if not hasEquippedTool() then
			sendHotbarKeyPress(selectedItem)
		end
	end
end

-- Bay thẳng đứng lên trời bằng CFrame theo vận tốc (stud/s) phụ thuộc vào Config.flySpeed, giới hạn trần độ cao 2500 rồi Anchor HRP
local function flyUpwardByCFrameStep(originPos, dt, runId)
	if not Config.autoFarm or ServerState.isLobbyFrozen or Runtime.autoFarmRunId ~= runId then
		return false
	end
	local _, _, hrp = getCharacterAndRoot()
	if not hrp or not originPos then
		return false
	end

	local ceilingY = tonumber(Config.MAX_FLIGHT_HEIGHT) or 2500
	if isCeilingAnchored then
		pcall(function()
			hrp.CFrame = CFrame.new(originPos.X, ceilingY, originPos.Z)
			hrp.Anchored = true
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end)
		return true
	end

	local speedStudPerSec = tonumber(Config.flySpeed)
	if not speedStudPerSec or speedStudPerSec < 0 then
		speedStudPerSec = tonumber(DEFAULT_CONFIG.flySpeed) or 100
	end

	if type(currentFlightY) ~= "number" then
		currentFlightY = math.min(hrp.Position.Y, ceilingY)
	end

	local deltaY = speedStudPerSec * math.max(0, tonumber(dt) or 0)
	local nextY = currentFlightY + deltaY
	local reachedCeiling = false
	if nextY >= ceilingY then
		nextY = ceilingY
		reachedCeiling = true
	end
	currentFlightY = nextY

	local ok = pcall(function()
		hrp.Anchored = false
		hrp.CFrame = CFrame.new(originPos.X, currentFlightY, originPos.Z)
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		if reachedCeiling then
			isCeilingAnchored = true
			hrp.Anchored = true
		end
	end)
	return ok
end

-- Giữ trạng thái khi tắt Auto Farm: nếu đang trong ván game thì anchor cơ thể cho tới khi bật lại Auto Farm
local function applyStopState(originPos)
	if isInActiveMatchContext() then
		isCharacterAnchoredForStop = true
		setCharacterAnchoredState(true)
	elseif originPos and Config.RETURN_ON_STOP then
		local _, _, hrp = getCharacterAndRoot()
		if hrp then
			pcall(function()
				hrp.Anchored = false
				hrp.CFrame = CFrame.new(originPos.X, originPos.Y, originPos.Z)
				hrp.AssemblyLinearVelocity = Vector3.zero
			end)
		end
	end
end

