-- Kiểm tra tồn tại + bọc pcall cho các hàm riêng của executor
local function hasExecutorFn(name)
	return type(getgenv()[name]) == "function" or type(_G[name]) == "function" or type(rawget(_G, name)) == "function" or pcall(function() return typeof(loadstring("return " .. name)()) == "function" end)
end

local function callExecutorFn(name, ...)
	local args = { ... }
	local fn = nil
	if type(getgenv()[name]) == "function" then
		fn = getgenv()[name]
	else
		local okEval, resEval = pcall(function()
			local chunk = loadstring("return " .. name)
			return chunk and chunk() or nil
		end)
		if okEval and type(resEval) == "function" then
			fn = resEval
		end
	end
	if type(fn) ~= "function" then
		return false, "Executor không hỗ trợ hàm '" .. tostring(name) .. "'"
	end
	local okCall, r1, r2 = pcall(function()
		return fn(table.unpack(args))
	end)
	if not okCall then
		return false, tostring(r1)
	end
	return true, r1, r2
end

-- Lấy parent an toàn cho ScreenGui (ưu tiên gethui, fallback CoreGui)
local function getSafeGuiParent()
	if hasExecutorFn("gethui") then
		local ok, hui = callExecutorFn("gethui")
		if ok and typeof(hui) == "Instance" then
			return hui
		end
	end
	return CoreGui
end

