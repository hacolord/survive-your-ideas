-- [ KHU VỰC 5: LOGIC PHÁT HIỆN & GHI TEXTBOX (TỪ TỐN TỪNG TỪ, CHỐNG GHI ĐÈ) ]
-- ============================================================================
local isBusy = false
local textboxCycleEntries = {}
local textboxCycleRawParsed = nil
local textboxCycleInvalid = false
local textboxCycleCursorIndex = 1
local lastTextboxCommitClock = 0

-- Kiểm tra và tách chuỗi ghi textbox hợp lệ dạng mục1/mục2/...
-- Hợp lệ: từng mục là <từ không chứa khoảng trắng, ;, /> hoặc <từ>;<số nguyên >= 1>
-- Không hợp lệ: ví dụ "earthquake;" (thiếu số sau ;) hoặc "tsunami blackhole earthquake" (nhiều từ cách khoảng trắng không có /)
local function parseTextboxCyclePattern(rawStr)
	local str = tostring(rawStr or "")
	if str == "" then
		return {}, false, false
	end

	-- Không cho phép khoảng trắng đầu/cuối hoặc nhiều từ cách khoảng trắng không phân tách bằng /
	if string.match(str, "^%s") or string.match(str, "%s$") or string.match(str, "%s") then
		return nil, true, false
	end

	-- Không cho phép // hoặc / ở đầu/cuối
	if string.match(str, "^/") or string.match(str, "/$") or string.find(str, "//", 1, true) then
		return nil, true, false
	end

	local entries = {}
	for part in string.gmatch(str, "[^/]+") do
		if string.find(part, ";", 1, true) then
			local wordPart, countPart = string.match(part, "^([^;]+);([^;]+)$")
			local maxCount = countPart and tonumber(countPart) or nil
			if not wordPart or not maxCount or maxCount < 1 or math.floor(maxCount) ~= maxCount or tostring(math.floor(maxCount)) ~= tostring(countPart) then
				return nil, true, false
			end
			table.insert(entries, {
				text = wordPart,
				maxCount = math.floor(maxCount),
				usedCount = 0
			})
		else
			if part == "" then
				return nil, true, false
			end
			table.insert(entries, {
				text = part,
				maxCount = nil, -- nil nghĩa là không giới hạn số lần ghi
				usedCount = 0
			})
		end
	end

	if #entries == 0 then
		return nil, true, false
	end

	return entries, false, true
end

local function resetTextboxCycle(notifyIfInvalid)
	local rawStr = tostring(Config.textboxText or "")
	local parsed, isInvalid, isValidPattern = parseTextboxCyclePattern(rawStr)
	textboxCycleRawParsed = rawStr
	textboxCycleInvalid = isInvalid == true
	textboxCycleEntries = (type(parsed) == "table") and parsed or {}
	textboxCycleCursorIndex = 1
	lastTextboxCommitClock = 0

	if isInvalid and notifyIfInvalid then
		notifyUser("Ghi textbox", "Chuỗi không hợp lệ (" .. rawStr .. "). Dùng dạng từ hoặc từ;số ngăn cách bằng dấu / (ví dụ: blackhole;1/earthquake/tsunami;11).", 5)
	end
	return isValidPattern
end

local function isEntryAvailable(entry)
	if not entry then
		return false
	end
	if entry.maxCount == nil then
		return true
	end
	return entry.usedCount < entry.maxCount
end

local function peekNextTextboxWordFromCycle()
	local rawStr = tostring(Config.textboxText or "")
	if rawStr == "" then
		return nil, nil, nil
	end
	if textboxCycleRawParsed ~= rawStr then
		resetTextboxCycle(true)
	end
	if textboxCycleInvalid or #textboxCycleEntries == 0 then
		return nil, nil, nil
	end

	local count = #textboxCycleEntries
	if textboxCycleCursorIndex < 1 or textboxCycleCursorIndex > count then
		textboxCycleCursorIndex = 1
	end

	-- Tìm mục khả dụng đầu tiên tính từ vị trí con trỏ hiện tại; nếu từ con trỏ tới cuối hết lượt thì quét tiếp từ đầu (1 -> cursorIndex - 1)
	for idx = textboxCycleCursorIndex, count do
		local entry = textboxCycleEntries[idx]
		if isEntryAvailable(entry) then
			return entry.text, entry, idx
		end
	end

	for idx = 1, textboxCycleCursorIndex - 1 do
		local entry = textboxCycleEntries[idx]
		if isEntryAvailable(entry) then
			return entry.text, entry, idx
		end
	end

	return nil, nil, nil
end

local function commitTextboxWordEntry(entry, usedIdx)
	if entry and entry.maxCount ~= nil and entry.usedCount < entry.maxCount then
		entry.usedCount += 1
	end
	local count = #textboxCycleEntries
	if count > 0 then
		local baseIdx = tonumber(usedIdx) or textboxCycleCursorIndex or 1
		local nextIdx = baseIdx + 1
		if nextIdx > count then
			nextIdx = 1
		end
		textboxCycleCursorIndex = nextIdx
	end
	lastTextboxCommitClock = os.clock()
end

-- Lấy TextBox đang mở/được chọn (theo code tham chiếu)
local function getActiveTextBox()
	local focused = pcall(function() return UserInputService:GetFocusedTextBox() end) and UserInputService:GetFocusedTextBox()
	if focused and focused:IsA("TextBox") then
		return focused
	end
	if GuiService.SelectedObject and GuiService.SelectedObject:IsA("TextBox") then
		return GuiService.SelectedObject
	end
	return nil
end

local function isKeyboardOrBoxOpen()
	if getActiveTextBox() then
		return true
	end
	local kb = pcall(function() return UserInputService.OnScreenKeyboardVisible end) and UserInputService.OnScreenKeyboardVisible
	return kb == true
end

local function waitForKeyboardOrBoxClose(runId)
	local maxWait = tonumber(Config.TEXTBOX_CLOSE_WAIT) or 2.0
	local pollStep = tonumber(Config.POLL_STEP) or 0.05
	local t0 = os.clock()
	while (os.clock() - t0) < maxWait do
		if not Config.autoFarm or ServerState.isLobbyFrozen or Runtime.autoFarmRunId ~= runId then
			return
		end
		if not isKeyboardOrBoxOpen() then
			return
		end
		task.wait(pollStep)
	end
end

local function fillActiveBox(text)
	local box = getActiveTextBox()
	if box then
		pcall(function()
			box.Text = text
		end)
		task.wait(Config.POST_SET_DELAY or 0.12)
		-- Ghi đè thêm 1 lần nếu game có script reset lại lúc mới focus
		pcall(function()
			if box.Text ~= text then
				box.Text = text
			end
			box:ReleaseFocus(true)
		end)
		return true
	end

	-- Dự phòng nếu không bắt được instance TextBox nhưng bàn phím ảo đã mở: gõ từ tốn từng ký tự
	if VirtualInputManager then
		local charDelay = tonumber(Config.CHAR_DELAY) or 0.06
		for i = 1, #text do
			local ch = string.sub(text, i, i)
			pcall(function()
				VirtualInputManager:SendTextInputCharacterEvent(ch, game)
			end)
			task.wait(charDelay)
		end
		return true
	end

	return false
end

-- Một lượt click toạ độ (chỉ thực hiện khi bật Click ảo): chỉ khi ô nhập/bàn phím thực sự bật lên mới ghi từ tốn 1 từ rồi chờ đóng hẳn và nghỉ nhịp
local function clickTargetAndTypeOnce(runId)
	if isBusy then
		return
	end
	if not Config.autoFarm or not isVirtualClickEnabled() or ServerState.isLobbyFrozen or Runtime.autoFarmRunId ~= runId then
		return
	end
	isBusy = true

	local targetX = tonumber(Config.clickX) or 380
	local targetY = tonumber(Config.clickY) or 172
	local rawTextPattern = tostring(Config.textboxText or "")
	local holdTime = Config.CLICK_HOLD or 0.06

	-- Giãn nhịp giữa các lần ghi chữ để không bị từ sau ghi đè lên từ trước chưa kịp thấy
	if rawTextPattern ~= "" and lastTextboxCommitClock > 0 then
		local cooldown = tonumber(Config.TEXTBOX_CYCLE_COOLDOWN) or 1.2
		local elapsedSinceCommit = os.clock() - lastTextboxCommitClock
		if elapsedSinceCommit < cooldown then
			local remain = cooldown - elapsedSinceCommit
			local tWait = os.clock()
			while (os.clock() - tWait) < remain do
				if not Config.autoFarm or not isVirtualClickEnabled() or ServerState.isLobbyFrozen or Runtime.autoFarmRunId ~= runId then
					isBusy = false
					return
				end
				task.wait(math.min(0.05, remain - (os.clock() - tWait)))
			end
		end
	end

	-- 1. Click vào toạ độ đã nhập (chỉ khi Click ảo đang bật)
	if VirtualInputManager and isVirtualClickEnabled() then
		pcall(function()
			VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, true, game, 1)
			task.wait(holdTime)
			VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, false, game, 1)
		end)
	end

	-- 2. Nếu ô Ghi textbox không rỗng: chỉ khi TextBox / bàn phím ảo bật lên mới ghi 1 từ từ tốn cho lần mở này
	if rawTextPattern ~= "" then
		local textToType, targetEntry, usedIdx = peekNextTextboxWordFromCycle()
		if textToType and textToType ~= "" then
			local detected = false
			local timeout = Config.DETECT_TIMEOUT or 2.0
			local pollStep = Config.POLL_STEP or 0.05
			local t0 = os.clock()
			while (os.clock() - t0) < timeout do
				if not Config.autoFarm or ServerState.isLobbyFrozen or Runtime.autoFarmRunId ~= runId then
					break
				end
				if isKeyboardOrBoxOpen() then
					detected = true
					break
				end
				task.wait(pollStep)
			end

			-- 3. Khi phát hiện ô nhập bật lên: chờ ngắn rồi điền đúng 1 từ từ tốn, chuyển sang mục tiếp theo và chờ ô đóng hẳn
			if detected and Config.autoFarm and not ServerState.isLobbyFrozen and Runtime.autoFarmRunId == runId then
				task.wait(Config.PRE_FILL_DELAY or 0.15)
				if Config.autoFarm and not ServerState.isLobbyFrozen and Runtime.autoFarmRunId == runId then
					fillActiveBox(textToType)
					commitTextboxWordEntry(targetEntry, usedIdx)
					waitForKeyboardOrBoxClose(runId)
				end
			end
		end
	end

	isBusy = false
end

